      "item": [
        {
          "id": "d5265304-54b7-4ffe-84ee-15b53064f3a2",
          "name": "List audit logs",
          "request": {
            "name": "List audit logs",
            "description": {
              "content": "Returns audit log records with `updatedAt` greater than the supplied lower bound,\nsorted ascending by `(updatedAt, _id)`. Supply `updatedAt` on the first call, then\nfollow `nextCursor` until `hasMore` is false. Requires the `audit-logs:read` scope.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "external",
                "v1",
                "audit-logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "updatedAt",
                  "value": "<dateTime>",
                  "description": "ISO-8601 lower bound. Required when no `cursor` is supplied. Returns records where `updatedAt` is strictly greater than this value."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque base64 cursor taken from the prior response `nextCursor`. When present it overrides `updatedAt`."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of records per page."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "redirect_uri",
                  "value": "https://us-east-1-acl.leena.ai/api/v1.0/oauth/token"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://us-east-1-acl.leena.ai/api/v1.0/oauth/token"
                },
                {
                  "key": "grant_type",
                  "value": "password_credentials"
                }
              ]
            }
          },
