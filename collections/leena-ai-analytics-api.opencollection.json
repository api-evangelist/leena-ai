{
  "opencollection": "1.0.0",
  "info": {
    "name": "Leena AI External AOP Analytics API",
    "version": "1.0-beta"
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query AI Colleague analytics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us-east-1-aic.leena.ai/api/analytics/query/external",
            "params": [
              {
                "name": "metricId",
                "value": "aic:totalRunsTable",
                "type": "query",
                "description": "Metric identifier, e.g. `aic:totalRunsTable`."
              },
              {
                "name": "responseType",
                "value": "table",
                "type": "query"
              },
              {
                "name": "from",
                "value": "2026-07-01",
                "type": "query"
              },
              {
                "name": "to",
                "value": "2026-07-19",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "filters[timestamp][gt]",
                "value": "",
                "type": "query",
                "description": "ISO-8601 lower bound for incremental polling."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://us-east-1-acl.leena.ai/api/v1.0/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns a tabular analytics result. Served from the region analytics host (`https://<region-code>-analytics-api.leena.ai`). Supports incremental polling via the `filters[timestamp][gt]` parameter."
        }
      ]
    }
  ],
  "bundled": true
}